{
  "name": "nest-angular-demo",
  "private": true,
  "packageManager": "npm@12.2.0",
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run frontend:build && npm run backend:build",
    "dev": "concurrently --kill-others --names backend,frontend \"npm:backend:start\" \"npm:frontend:start\"",
    "frontend:build": "npm run build --workspace frontend",
    "backend:build": "npm run build --workspace backend",
    "frontend:test": "npm test --workspace frontend",
    "backend:test": "npm test --workspace backend",
    "bruno:test": "concurrently --kill-others --success command-bruno --names backend,bruno \"npm:backend:start\" \"wait-on --timeout 60000 http-get://localhost:8080/api/tracks && cd bruno && bru run --env Local --tests-only\"",
    "test": "npm run frontend:test && npm run backend:test",
    "frontend:start": "npm run start --workspace frontend -- --proxy-config proxy.conf.json",
    "backend:start": "npm run start:dev --workspace backend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
